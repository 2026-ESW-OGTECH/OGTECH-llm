[Unit]
Description=SafeAid STM32 물리 음성 버튼 push-to-talk
After=sound.target smartaid-map.service
Requires=smartaid-map.service

[Service]
Type=simple
User=safeaid
SupplementaryGroups=audio
WorkingDirectory=/opt/safeaid/Co-LLM
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/safeaid/audio.env
ExecStart=/opt/safeaid/Co-LLM/.venv/bin/python /opt/safeaid/Co-LLM/scripts/physical_voice.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
