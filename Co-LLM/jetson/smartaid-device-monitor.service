[Unit]
Description=SafeAid CO·트레일·일조 선제 음성 알림
After=sound.target smartaid-map.service
Requires=smartaid-map.service

[Service]
Type=simple
User=safeaid
SupplementaryGroups=audio
WorkingDirectory=/opt/safeaid/Co-LLM
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/safeaid/audio.env
ExecStart=/opt/safeaid/Co-LLM/.venv/bin/python /opt/safeaid/Co-LLM/scripts/device_monitor.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
