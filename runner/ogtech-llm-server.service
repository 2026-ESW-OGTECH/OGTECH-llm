[Unit]
Description=OGTECH llama-server (Qwen2.5 1.5B Q4_K_M, 의도 분류 전용)
After=network.target
# 음성 데몬이 이 서비스를 Requires로 걸지 않는다 — LLM이 죽어도 고정 카드 폴백으로 동작해야 한다(경로 B).

[Service]
Type=simple
User=safeaid
WorkingDirectory=/opt/ogtech
EnvironmentFile=-/etc/ogtech/llm.env
ExecStart=/usr/bin/env bash /opt/ogtech/runner/start_llama_server.sh --foreground
# 기동 뒤 워밍업: 프리픽스를 KV 캐시에 올려 첫 질문의 cold prefill(2~3 s)을 없앤다.
ExecStartPost=/usr/bin/env bash -c 'sleep 20; cd /opt/ogtech && python3 -m harness.preflight >> /opt/ogtech/results/preflight.log 2>&1 || true'
Restart=on-failure
RestartSec=3
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
