[Unit]
Description=SafeAid 물리 전원 버튼 STM32 gate ACK 및 정상 종료
After=local-fs.target smartaid-map.service
Before=shutdown.target
Wants=smartaid-map.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/safeaid/MAP
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/systemd-inhibit --what=shutdown --who=SafeAid --why="STM32 gate ACK 전송" --mode=delay /opt/safeaid/MAP/.venv/bin/python /opt/safeaid/MAP/jetson/power_control.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
